<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="22dp"
        android:background="@drawable/bg_glass">

        <TextView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/chat_bot_bg"
            android:gravity="center"
            android:text="🐾"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANIMORA Assistant"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online"
                android:textColor="#B9FBC0"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CHAT MESSAGES -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp"/>

    </ScrollView>

    <!-- QUICK QUESTIONS -->

    <!-- MESSAGE INPUT -->
    <LinearLayout
        android:id="@+id/suggestionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00FFFFFF"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Quick questions"
            android:textColor="#0081A7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/questionGPS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chat_suggestion_bg"
                    android:padding="11dp"
                    android:text="📍 GPS Tracking"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/questionActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chat_suggestion_bg"
                    android:padding="11dp"
                    android:textColor="@color/black"
                    android:text="🐕 Activity"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/questionTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chat_suggestion_bg"
                    android:padding="11dp"
                    android:textColor="@color/black"
                    android:text="🌡 Temperature"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/questionHeart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chat_suggestion_bg"
                    android:padding="11dp"
                    android:textColor="@color/black"
                    android:text="❤️ Heart Rate"
                    android:textSize="12sp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Ask me anything..."
            android:textSize="14sp"
            android:textColor="#263B40"
            android:textColorHint="#9AA8AA"
            android:background="@drawable/chat_input_bg"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:imeOptions="actionSend"/>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/chat_send_bg"
            android:tint="#FFFFFF"
            android:contentDescription="Send message"
            android:scaleType="center"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Navbar background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/nav_bg"
            android:elevation="8dp">

            <!-- Left: Chatbot -->
            <LinearLayout
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/chatbot"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/chat"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chatbot"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chatbot"
                    android:textColor="#0081A7"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Center space -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Right: Settings -->
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:src="@drawable/settings"
                    android:scaleType="fitCenter"
                    android:contentDescription="Settings"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#0081A7"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Center: Home -->
        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/circle_coral"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/paw1"
                android:scaleType="fitCenter"
                android:contentDescription="Home"/>
        </FrameLayout>

    </FrameLayout>
</LinearLayout>
